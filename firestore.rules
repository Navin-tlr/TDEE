rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule is now smarter and avoids the race condition.
    // It checks if the requesting user's UID matches the UID in the document's ID.
    match /food_daily/{docId} {
      allow read: if request.auth.uid == docId.split('_')[0];
      
      // The write rule remains the same, as it's for creating/updating data.
      allow write: if request.auth.uid == request.resource.data.uid;
    }
  }
}
